    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.1",
    "@scarf/scarf": "^1.4.0",
    "approve": "^0.0.12",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
