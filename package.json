  "type": "module",
  "scripts": {
    "start:gw:dev": "node --watch --import @swc-node/register/esm-register apps/app-gw/src/main.ts",
    "start:gw:mock-providers:dev": "NODE_OPTIONS=\"--import $PWD/../e2e/oauth-mock.mjs\" THROTTLE_LIMIT=1000 SIGNUP_THROTTLE_LIMIT=1000 node --watch --import @swc-node/register/esm-register apps/app-gw/src/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint --type-aware apps/ libs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
