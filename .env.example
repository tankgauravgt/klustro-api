# URL of the `app-gw` service:
APPS_GW__URL="http://localhost:4000"

# URL of the frontend:
WEB_URL="http://localhost:3000"

# Database path:
DB_PATH=":memory:"

# Database is SQLite?
USE_SQLITE_DATABASE="1"

# JWT configuration:
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1h"

# Google OAuth:
APPS_AUTH__GOOGLE_CLIENT_ID=""
APPS_AUTH__GOOGLE_CLIENT_SECRET=""

# GitHub OAuth:
APPS_AUTH__GITHUB_CLIENT_ID=""
APPS_AUTH__GITHUB_CLIENT_SECRET=""

# Mailgun credentials:
MAILGUN_SENDING_API_KEY=""
MAILGUN_BASEURL="api.mailgun.net"

# Rate-limiting:
THROTTLE_TTL_SECONDS="60"
THROTTLE_LIMIT="20"

# Sign up rate-limiting:
SIGNUP_THROTTLE_LIMIT="5"

# Proxies whose X-Forwarded-For is believed; the client is the first address that is not one of them.
# Use addresses/subnets, not a hop count: "loopback" is the gateway, "linklocal" (169.254.0.0/16) is Azure's front end.
# Use 0 for direct connections. Only reachable through the proxy? Restrict ingress too, or any client can talk to the app directly.
TRUST_PROXY="loopback, linklocal"
